index 000000000..8372d84bd
--- /dev/null
+++ b/packages/kosong/src/providers/client-policy.ts
@@ -0,0 +1,25 @@
+/**
+ * Per-request HTTP policy applied to every provider SDK client.
+ *
+ * `PROVIDER_REQUEST_TIMEOUT_MS` — both SDKs default to a 10-minute
+ * per-request timeout, and their timers only cover the phase up to
+ * response headers: `fetchWithTimeout` clears its timer in `finally`
+ * when the fetch promise settles (verified in openai@6.34 `client.js`
+ * and @anthropic-ai/sdk@0.95.2 `client.js:562`), so streaming bodies
+ * are never subject to the client timeout. A hung pre-headers attempt
+ * therefore used to sit for up to 10 minutes before `chatWithRetry`
+ * even saw the failure — long enough to look dead to any client-side
+ * watchdog. 120s is comfortably above p99 time-to-first-byte for the
+ * supported providers and far below typical client idle budgets
+ * (acp-desktop's is 300s), so a wedged attempt fails fast into the
+ * observable retry loop instead of sitting silently.
+ *
+ * `PROVIDER_REQUEST_MAX_RETRIES` — both SDKs retry internally (default
+ * 2 extra attempts) without emitting anything, stacking invisible waits
+ * on top of kosong's own `chatWithRetry` backoff. Zeroing SDK-level
+ * retries makes every retry flow through `chatWithRetry`, where it
+ * surfaces as a `step.retrying` event (and, over ACP, a `wait_state`
+ * frame) instead of silent delay.
+ */
+export const PROVIDER_REQUEST_TIMEOUT_MS = 120_000;
+export const PROVIDER_REQUEST_MAX_RETRIES = 0;
