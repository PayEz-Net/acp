+/**
+ * Stream pair with a byte-level tap on the agent→client direction.
+ *
+ * The typed `ClientSideConnection` validates every incoming
+ * `session/update` against the closed `zSessionUpdate` union and drops
+ * unknown variants — including our custom `wait_state` frames — before
+ * the `Client` implementation ever sees them. That IS the intended
+ * degradation for third-party clients, but it makes the typed client
+ * useless for asserting on `wait_state`. The tap records the raw ndjson
+ * so tests can verify exactly what the adapter put on the wire.
+ */
+function makeTappedStreamPair(): {
+  agentStream: ReturnType<typeof ndJsonStream>;
+  clientStream: ReturnType<typeof ndJsonStream>;
+  wireNotifications: () => Array<{ sessionId: string; update: Record<string, unknown> }>;
+} {
+  const clientToAgent = new TransformStream<Uint8Array, Uint8Array>();
+  const agentToClient = new TransformStream<Uint8Array, Uint8Array>();
+  const chunks: Uint8Array[] = [];
+  const tap = new TransformStream<Uint8Array, Uint8Array>({
+    transform(chunk, controller) {
+      chunks.push(chunk);
+      controller.enqueue(chunk);
+    },
+  });
+  const agentStream = ndJsonStream(agentToClient.writable, clientToAgent.readable);
+  const clientStream = ndJsonStream(
+    clientToAgent.writable,
+    agentToClient.readable.pipeThrough(tap),
+  );
+  const wireNotifications = () => {
+    const total = chunks.reduce((n, c) => n + c.length, 0);
+    const merged = new Uint8Array(total);
+    let offset = 0;
+    for (const chunk of chunks) {
+      merged.set(chunk, offset);
+      offset += chunk.length;
+    }
+    return new TextDecoder()
+      .decode(merged)
+      .split('\n')
+      .filter((line) => line.trim().length > 0)
+      .map((line) => JSON.parse(line) as { method?: string; params?: unknown })
+      .filter((msg) => msg.method === 'session/update')
+      .map(
+        (msg) =>
+          msg.params as { sessionId: string; update: Record<string, unknown> },
+      );
+  };
+  return { agentStream, clientStream, wireNotifications };
+}
