+/**
+ * What the runtime is currently waiting on. Surfaced to clients so a
+ * silent-but-healthy turn is distinguishable from a wedged one without
+ * resorting to idle timers:
+ *
+ *  - `'awaiting_first_token'`: a step's LLM request is in flight but no
+ *    assistant output has streamed yet (provider latency). Emitted once
+ *    per `turn.step.started`; implicitly cleared by the first content
+ *    notification of the step.
+ *  - `'provider_retry'`: a provider request failed with a retryable
+ *    error and `chatWithRetry` is backing off before the next attempt.
+ *    Carries the attempt counters and the chosen delay so the client
+ *    can render "attempt 3/10, next retry in 12s".
+ */
+export type WaitStateKind = 'awaiting_first_token' | 'provider_retry';
+
+/**
+ * Flat payload carried by the `wait_state` session update. Retry fields
+ * are only present for {@link WaitStateKind} `'provider_retry'`.
+ */
+export interface WaitStatePayload {
+  readonly kind: WaitStateKind;
+  readonly failedAttempt?: number;
+  readonly nextAttempt?: number;
+  readonly maxAttempts?: number;
+  readonly delayMs?: number;
+  readonly errorName?: string;
+  readonly errorMessage?: string;
+  readonly statusCode?: number;
+}
+
+/**
+ * Build a `wait_state` `session/update` notification.
+ *
+ * `'wait_state'` is NOT one of the thirteen variants in the ACP
+ * `SessionUpdate` union — the union is closed and has no wait/report
+ * variant. `_meta` was considered and rejected: `SessionNotification`
+ * still requires a valid `update` variant, so a meta-only design would
+ * have to piggyback a fake chunk that conforming clients would render.
+ * A custom variant is honest on the wire (`sessionUpdate` is a plain
+ * string in JSON), clients that do not recognize it ignore it (their
+ * behaviour is unchanged from today), and the acp-desktop client
+ * consumes it explicitly. The `as unknown as` cast is the price of the
+ * closed union — the runtime JSON is exactly the flat shape declared in
+ * {@link WaitStatePayload} plus the discriminator.
+ */
+export function waitStateToSessionUpdate(
+  sessionId: string,
+  payload: WaitStatePayload,
+): SessionNotification {
+  return {
+    sessionId,
+    update: {
+      sessionUpdate: 'wait_state',
+      ...payload,
+    } as unknown as SessionNotification['update'],
+  };
+}
+
+/**
+ * One-shot wait-state frame emitted when a step begins: the runtime is
+ * waiting on the provider's first token. Cleared implicitly on the
+ * client when the first content notification of the step arrives.
+ */
+export function awaitingFirstTokenToSessionUpdate(sessionId: string): SessionNotification {
+  return waitStateToSessionUpdate(sessionId, { kind: 'awaiting_first_token' });
+}
+
+/**
+ * Map an SDK `turn.step.retrying` event to a `wait_state` session
+ * update. The retry loop (`chatWithRetry`) dispatches this after a
+ * failed attempt, before sleeping `delayMs` — exactly the window that
+ * used to look like a hang to clients.
+ */
+export function stepRetryingToSessionUpdate(
+  sessionId: string,
+  event: TurnStepRetryingEvent,
+): SessionNotification {
+  return waitStateToSessionUpdate(sessionId, {
+    kind: 'provider_retry',
+    failedAttempt: event.failedAttempt,
+    nextAttempt: event.nextAttempt,
+    maxAttempts: event.maxAttempts,
+    delayMs: event.delayMs,
+    errorName: event.errorName,
+    errorMessage: event.errorMessage,
+    statusCode: event.statusCode,
+  });
+}
