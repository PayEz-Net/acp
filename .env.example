# =============================================================================
# ACP Pro — configuration contract
# =============================================================================
# Copy to .env and fill in YOUR endpoints/credentials. Nothing here is a secret
# by default — real secrets stay in your .env (gitignored), never in the repo.
#
# ACP Pro talks to three things you provide:
#   1. VibeSQL  — your VibeSQL server (data)
#   2. Vibe API — the PayEz Vibe API (agent mail, kanban, teams, projects)
#   3. IDP      — the PayEz IDP token authority (auth)
# =============================================================================

# --- VibeSQL -----------------------------------------------------------------
# Your VibeSQL server. Local dev default shown; point at your own.
VIBESQL_URL=http://127.0.0.1:52411

# --- PayEz Vibe API ----------------------------------------------------------
# The Vibe API base URL ACP Pro integrates with.
VIBE_API_URL=https://your-vibe-api.example.com

# --- PayEz IDP (token authority) ---------------------------------------------
IDP_URL=https://your-idp.example.com

# Non-secret client identifier issued to your ACP install.
ACP_CLIENT_ID=

# --- Desktop renderer (Vite) -------------------------------------------------
# The renderer reads VITE_-prefixed vars at build time.
VITE_IDP_URL=https://your-idp.example.com
VITE_VIBE_API_URL=https://your-vibe-api.example.com

# --- Local ACP gateway -------------------------------------------------------
# Port the bundled API listens on locally.
ACP_API_PORT=3001
