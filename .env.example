# ACP Desktop — Environment Variables
# Copy to .env and fill in values. NEVER commit .env (or .env.* with real
# values) to git — only this .env.example belongs in the repo.

# ---------------------------------------------------------------------------
# Vibe / IDP tenant — REQUIRED to run against a Vibe backend
# ---------------------------------------------------------------------------
# Your Vibe client identifier (public-safe, like an OAuth client_id). NO tenant
# is baked into the source — each deployment uses its own. If unset, the
# backend's required('VIBE_CLIENT_ID') check hard-fails with a clear error.
ACP_VIBE_CLIENT_ID=

# Your Vibe client signing secret (HMAC, machine-to-machine). NEVER commit a
# real value. Leave blank if you only use Bearer/token auth.
ACP_VIBE_CLIENT_SECRET=

# Base URL of your Vibe API.
# e.g. https://api.your-vibe-host.example
ACP_VIBE_API_URL=

# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------
# Base URL of the local ACP backend API sidecar. Defaults to
# http://127.0.0.1:3001 when unset.
ACP_API_URL=

# Shared secret for the local API sidecar (loopback-only auth). Leave blank to
# use the value the app persists; set explicitly for headless/dev runs.
ACP_LOCAL_SECRET=

# Active environment name (selects the baked endpoint set). Optional.
ACP_ENV=

# Storage backend for local state. One of: vibesql (default) | redis.
STORAGE_MODE=

# Redis connection string — only required when STORAGE_MODE=redis.
# e.g. redis://localhost:6379
REDIS_URL=

# Agent-mail poll interval in milliseconds. Optional tuning; sensible default
# applies when unset.
ACP_MAIL_POLL_MS=

# Override the workspace root the app colonizes/operates on. Optional.
OTHER_WORKSPACE_ROOT=

# Renderer (Vite) dev override for the IDP base URL. Optional; dev mode only
# (npm run dev:electron).
VITE_IDP_URL=

# ---------------------------------------------------------------------------
# Bundled agent-mail CLI — test mode (agent-mail-cli/ --test)
# ---------------------------------------------------------------------------
# Separate tenant/host used by the CLI's --test flag. All optional.
ACP_VIBE_API_URL_TEST=
ACP_VIBE_CLIENT_ID_TEST=
ACP_VIBE_CLIENT_SECRET_TEST=

# ---------------------------------------------------------------------------
# macOS Code Signing & Notarization (release builds only)
# ---------------------------------------------------------------------------
# Apple ID for notarization (e.g. you@example.com)
APPLE_ID=

# App-Specific Password generated at https://appleid.apple.com/account/manage
# (NOT your regular Apple ID password)
APPLE_APP_SPECIFIC_PASSWORD=

# Apple Developer Team ID (10 characters, e.g. ABCD123456)
# Found at https://developer.apple.com/account#MembershipDetailsCard
APPLE_TEAM_ID=

# Optional: force a specific signing identity instead of auto-detect
# CSC_NAME=Developer ID Application: Your Org (ABCD123456)

# ---------------------------------------------------------------------------
# Injected at runtime by ACP into spawned agent processes — DO NOT set these
# yourself: ACP_AGENT_ID, ACP_AGENT_NAME, ACP_SURFACE_ID, VIBE_AGENT.
# ---------------------------------------------------------------------------
