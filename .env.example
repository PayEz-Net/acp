# acp-api — copy to .env and fill with your dev credentials.
# .env is gitignored; .env.example is committed as the schema reference.

# Vibe client credential for cloud vibe-api calls. Matches a row in
# core_identity.vibe_client_credentials (client_id + app_signing_key).
# Pull from your IDP DB, don't invent.
VIBE_CLIENT_ID=
VIBE_HMAC_KEY=

# Your user_id on the cloud vibe-api (core_identity.users).
# Required for HMAC service-account calls (unattended mode pings).
# Without it the cloud rejects with USER_REQUIRED.
VIBE_USER_ID=

# Optional endpoint overrides — defaults point at 10.0.0.93 dev box.
# IDP_URL=http://10.0.0.93:32785
# VIBE_API_URL=http://10.0.0.93:32786
