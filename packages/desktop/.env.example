# ACP Desktop — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ---------------------------------------------------------------------------
# macOS Code Signing & Notarization
# ---------------------------------------------------------------------------
# Apple ID for notarization (e.g. dev@payez.net)
APPLE_ID=

# App-Specific Password generated at https://appleid.apple.com/account/manage
# (NOT your regular Apple ID password)
APPLE_APP_SPECIFIC_PASSWORD=

# Apple Developer Team ID (10 characters, e.g. ABCD123456)
# Found at https://developer.apple.com/account#MembershipDetailsCard
APPLE_TEAM_ID=

# Optional: force a specific signing identity instead of auto-detect
# CSC_NAME=Developer ID Application: PayEz (ABCD123456)
